generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Property {
  id                    String                @id
  serialNumber          String                @unique
  unitLabel             String?
  unitNumber            String
  streetAddress         String
  cityState             String
  kind                  String
  ownership             String
  spaPrice              Float
  bookValue             Float
  marketValue           Float
  projectName           String
  developerName         String
  tenancyAgreementId    String?
  tenancyAgreementLabel String?
  numberOfRooms       Int?
  carParks            Int?
  squareFeet          Float?
  otherAppliances     String?
  ceilingFans         Int?
  renovations         RenovationItem[]
  tenancies           Tenancy[]
  monthlyIncomes      MonthlyRentalIncome[]
  monthlyExpenses     MonthlyExpenseEntry[]
  expenseTxns         ExpenseTransaction[]
}

model RenovationItem {
  id                 String   @id
  propertyId         String
  amountPaid         Float
  paymentDate        String
  invoiceNumber      String
  description        String
  depreciationPeriod Int
  attachmentName     String?
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Tenant {
  id                     String         @id
  name                   String
  nricPassport           String
  email                  String
  mobile                 String
  emergencyContactName   String?
  emergencyContactNumber String?
  tenancies              Tenancy[]
  userProfile            TenantProfile?
}

model Tenancy {
  id                    String                 @id
  propertyId            String
  tenantId              String
  rentalDeposit         Float
  surcharge             Float
  monthlyGross          Float
  dateOfCollection      String
  serviceFeeDeduction   Float
  monthlyNet            Float
  dateOfNetRemitted     String
  cumulativeGross       Float
  cumulativeNet         Float
  lateCollectionFlag    Boolean
  maintenanceCharges    Float
  quitRent              Float
  assessment            Float
  utilityCharges        Float
  fireInsurancePremium  Float
  sinkingFundPayment    Float
  miscellaneousCharges  Float
  bankCostOfFunds       Float
  depreciationCost      Float
  commencementDate      String
  keyCollectionDate     String
  moveInDate            String
  expirationDate        String
  tenure                String
  airSelangorAccount    String
  tnbAccount            String
  tmAccount             String
  status                String
  closedEarly           Boolean
  agentCommissionAmount Float?
  specialClauses        String?
  signedAgreementUrl    String?
  moveInPicturesUrl     String?
  moveOutPicturesUrl    String?
  property              Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentCollections       RentCollectionRecord[]
  depositTxns           DepositTransaction[]
  expenseTxns           ExpenseTransaction[]
  activities            TenantActivity[]
  maintenanceRequests   MaintenanceRequest[]
  paymentReceipts       PaymentReceipt[]
  utilityBills          UtilityBill[]
}

model ExpenseCategory {
  id             String                @id
  name           String
  groupType      String
  isNonCash      Boolean               @default(false)
  sortOrder      Int
  monthlyEntries MonthlyExpenseEntry[]
}

model MonthlyRentalIncome {
  id                String   @id
  propertyId        String
  periodMonth       String
  grossRentalAmount Float
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, periodMonth])
}

model MonthlyExpenseEntry {
  id                String          @id
  propertyId        String
  periodMonth       String
  expenseCategoryId String
  amount            Float
  notes             String?
  property          Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)

  @@unique([propertyId, periodMonth, expenseCategoryId])
}

model RentCollectionRecord {
  id                     String  @id
  tenancyId              String
  expectedCollectionDate String
  actualCollectionDate   String?
  amountCollected        Float
  serviceAdminFee        Float
  sst                    Float
  dateRemitted           String?
  expectedAmount         Float?
  notes                  String?
  tenancy                Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
}

model DepositTransaction {
  id        String  @id
  tenancyId String
  date      String
  type      String
  amount    Float
  notes     String?
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
}

model ExpenseTransaction {
  id            String   @id
  tenancyId     String?
  propertyId    String
  datePaid      String
  expenseType   String
  amount        Float
  invoiceNumber String?
  description   String?
  tenancy       Tenancy? @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model TenantActivity {
  id        String  @id
  tenancyId String
  date      String
  type      String
  notes     String
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
}

model SystemActivityLog {
  id        String @id
  timestamp String
  entity    String
  action    String
  details   String
}

model User {
  id            String   @id
  email         String   @unique
  username      String?  @unique
  passwordHash  String
  role          String   // 'ADMIN', 'EMPLOYEE', 'TENANT'
  status        String   // 'ACTIVE', 'SUSPENDED', 'PENDING'
  firstName     String
  lastName      String
  createdAt     String
  lastLoginAt   String?
  
  tenantProfile        TenantProfile?
  maintenanceAssignments MaintenanceRequest[] @relation("AssignedEmployee")
  notifications        Notification[]
}

model TenantProfile {
  id                     String  @id
  userId                 String  @unique
  tenantId               String  @unique
  phoneNumber            String?
  alternateEmail         String?
  preferredContactMethod String? // 'EMAIL', 'SMS', 'PHONE'
  notificationsEnabled   Boolean @default(true)
  
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model MaintenanceRequest {
  id               String   @id
  tenancyId        String
  requestedBy      String
  category         String   // 'PLUMBING', 'ELECTRICAL', 'AC', 'APPLIANCES', 'OTHER'
  title            String
  description      String
  urgency          String   // 'LOW', 'MEDIUM', 'HIGH', 'EMERGENCY'
  status           String   // 'SUBMITTED', 'ACKNOWLEDGED', 'IN_PROGRESS', 'RESOLVED', 'CLOSED'
  submittedDate    String
  acknowledgedDate String?
  resolvedDate     String?
  estimatedCost    Float?
  actualCost       Float?
  assignedTo       String?
  
  tenancy     Tenancy                  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  assignee    User?                    @relation("AssignedEmployee", fields: [assignedTo], references: [id])
  attachments MaintenanceAttachment[]
  comments    MaintenanceComment[]
}

model MaintenanceAttachment {
  id         String @id
  requestId  String
  fileName   String
  fileUrl    String
  uploadedBy String
  uploadedAt String
  fileType   String // 'IMAGE', 'DOCUMENT', 'VIDEO'
  fileSize   Int    // in bytes
  
  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model MaintenanceComment {
  id        String @id
  requestId String
  userId    String
  userName  String
  comment   String
  timestamp String
  
  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model PaymentReceipt {
  id                 String  @id
  tenancyId          String
  uploadedBy         String
  paymentDate        String
  amount             Float
  paymentMethod      String  // 'BANK_TRANSFER', 'CASH', 'CHEQUE', 'ONLINE'
  referenceNumber    String?
  receiptUrl         String
  fileName           String
  uploadedAt         String
  verifiedBy         String?
  verificationDate   String?
  verificationStatus String  // 'PENDING', 'VERIFIED', 'REJECTED'
  rejectionReason    String?
  notes              String?
  
  tenancy Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
}

model UtilityBill {
  id         String  @id
  tenancyId  String
  uploadedBy String
  billType   String  // 'ELECTRICITY', 'WATER', 'GAS', 'INTERNET'
  billMonth  String  // YYYY-MM format
  amount     Float
  dueDate    String
  billUrl    String
  fileName   String
  uploadedAt String
  paidDate   String?
  paidBy     String? // 'TENANT', 'LANDLORD'
  status     String  // 'UPLOADED', 'PAID', 'OVERDUE'
  notes      String?
  
  tenancy Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String  @id
  userId    String
  type      String  // 'PAYMENT_DUE', 'PAYMENT_CONFIRMED', 'MAINTENANCE_UPDATE', 'LEASE_EXPIRY', 'ANNOUNCEMENT'
  title     String
  message   String
  isRead    Boolean @default(false)
  createdAt String
  relatedId String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
